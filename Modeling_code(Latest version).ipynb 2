    "import plotly.graph_objects as go\n",
    "from statsmodels.nonparametric.smoothers_lowess import lowess\n",
    "\n",
    "# align y to the OLS training index so lengths match\n",
    "y_aligned = y.loc[ols_model.fittedvalues.index]\n",
    "\n",
    "y_pred = ols_model.fittedvalues.to_numpy()\n",
    "resid  = (y_aligned - ols_model.fittedvalues).to_numpy()\n",
    "\n",
    "# guard against NaN/Inf before LOWESS\n",
    "mask = np.isfinite(y_pred) & np.isfinite(resid)\n",
    "smoothed = lowess(resid[mask], y_pred[mask], frac=0.2, return_sorted=True)\n",
    "\n",
    "\n",
    "fig = go.Figure()\n",
    "fig.add_trace(go.Scatter(x=y_pred, y=resid, mode=\"markers\",\n",
    "                         marker=dict(size=4, opacity=0.4), name=\"Residuals\"))\n",
    "fig.add_hline(y=0, line_dash=\"dash\")\n",
    "fig.add_trace(go.Scatter(x=smoothed[:,0], y=smoothed[:,1], mode=\"lines\", name=\"LOWESS\"))\n",
    "fig.update_layout(\n",
    "    title=\"Residuals vs Fitted\",\n",
    "    xaxis_title=\"Fitted values (log（Views))\",\n",
    "    yaxis_title=\"Residuals\",\n",
    "    template=\"plotly_white\",\n",
    "    width=800,\n",
    "    height=500,\n",
    "    hovermode=\"closest\"\n",
    ")\n",
    "\n",
    "fig.show()\n"
