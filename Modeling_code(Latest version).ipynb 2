    "from sklearn.model_selection import KFold, cross_validate\n",
    "from sklearn.linear_model import LinearRegression\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# --- assumes you already created df_clean, selected_features, X, y as in your script ---\n",
    "# If running standalone, re-run your cleaning/feature code first.\n",
    "\n",
    "linreg = LinearRegression()\n",
    "\n",
    "cv = KFold(n_splits=6, shuffle=True, random_state=42)\n",
    "scoring = {\n",
    "    \"r2\": \"r2\",\n",
    "    \"neg_mse\": \"neg_mean_squared_error\"   # we'll sqrt & flip sign for RMSE\n",
    "}\n",
    "\n",
    "cv_res = cross_validate(\n",
    "    linreg, X, y,\n",
    "    cv=cv,\n",
    "    scoring=scoring,\n",
    "    return_train_score=False\n",
    ")\n",
    "\n",
    "r2_folds = cv_res[\"test_r2\"]\n",
    "rmse_folds = np.sqrt(-cv_res[\"test_neg_mse\"])\n",
    "\n",
    "print(\"=== 6-Fold Cross-Validation (log scale) ===\")\n",
    "print(\"R² per fold:   \", np.round(r2_folds, 4))\n",
    "print(\"R² mean ± std: \", f\"{r2_folds.mean():.4f} ± {r2_folds.std():.4f}\")\n",
    "\n",
    "print(\"\\nRMSE per fold: \", np.round(rmse_folds, 4))\n",
